<Window x:Class="PhoneBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Телефонная книга" 
        Height="550" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        MinHeight="400" 
        MinWidth="700">

    <DockPanel>
        <!-- Панель навигации -->
        <StackPanel DockPanel.Dock="Top" 
                    Orientation="Horizontal" 
                    Background="#FF4A4A4A"
                    Height="50">

            <Button Content="Контакты" 
                    Command="{Binding ShowContactsCommand}"
                    Margin="10,0,10,0"
                    Padding="15,8"
                    FontSize="14"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button Content="О программе" 
                    Command="{Binding ShowAboutCommand}"
                    Margin="10,0,10,0"
                    Padding="15,8"
                    FontSize="14"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- Область контента (ContentControl для навигации) -->
        <ContentControl Content="{Binding NavigationService.CurrentViewModel}" />
    </DockPanel>
</Window>