<Window x:Class="FigureFactory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фабричный метод - Фигуры" 
        Height="450" 
        Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Выбор цвета -->
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,10">
            <TextBlock Text="Выберите цвет фигур: " 
                       VerticalAlignment="Center" 
                       FontSize="16"/>
            <ComboBox x:Name="ColorComboBox" 
                      Width="150" 
                      Margin="10,0" 
                      SelectedIndex="0"
                      FontSize="16">
                <ComboBoxItem Content="Красный" Tag="Red"/>
                <ComboBoxItem Content="Синий" Tag="Blue"/>
                <ComboBoxItem Content="Зелёный" Tag="Green"/>
            </ComboBox>
        </StackPanel>

        <!-- Кнопки создания фигур -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,10">
            <Button x:Name="AddCircleButton" 
                    Content="Добавить круг" 
                    Width="120" 
                    Height="40" 
                    Margin="5"
                    Click="AddCircleButton_Click"/>
            <Button x:Name="AddSquareButton" 
                    Content="Добавить квадрат" 
                    Width="120" 
                    Height="40" 
                    Margin="5"
                    Click="AddSquareButton_Click"/>
            <Button x:Name="AddTriangleButton" 
                    Content="Добавить треугольник" 
                    Width="120" 
                    Height="40" 
                    Margin="5"
                    Click="AddTriangleButton_Click"/>
            <Button x:Name="ClearButton" 
                    Content="Очистить" 
                    Width="80" 
                    Height="40" 
                    Margin="5"
                    Click="ClearButton_Click"/>
        </StackPanel>

        <!-- Панель для отображения фигур -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto"
                      BorderBrush="Gray" 
                      BorderThickness="1">
            <WrapPanel x:Name="FiguresPanel" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top"/>
        </ScrollViewer>
    </Grid>
</Window>